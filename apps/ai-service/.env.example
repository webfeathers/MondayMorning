# Service Configuration
SERVICE_NAME=wf-ai-service
SERVICE_VERSION=0.0.1
API_PREFIX=/api/v1
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# OpenAI (required for CrewAI)
OPENAI_API_KEY=sk-...

# Optional OpenAI Model Override
OPENAI_MODEL=gpt-4o-mini

# Security (optional)
API_KEY=

# Observability
LOG_LEVEL=INFO
SENTRY_DSN=

# Execution Limits
MAX_EXECUTION_TIME_SECONDS=300
MAX_CONTEXT_TOKENS=100000
