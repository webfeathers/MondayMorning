# Sentry Configuration
# Add these variables to your .env files for error tracking and performance monitoring

# ===== Sentry DSN =====
# Get this from your Sentry project settings
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id

# ===== Environment =====
SENTRY_ENVIRONMENT=development  # or production, staging, etc.
SENTRY_ENABLED=false  # Set to 'true' to enable Sentry

# ===== Release Tracking =====
# Optional: Track which version of your code is running
# Format: service@version (e.g., web@1.0.0, worker@1.0.0)
SENTRY_RELEASE=

# ===== Sampling Rates =====
# Performance monitoring sample rate (0.0 to 1.0)
# 0.1 = 10% of transactions will be sent to Sentry
SENTRY_TRACES_SAMPLE_RATE=0.1

# Profiling sample rate (0.0 to 1.0)
# Only applies when tracing is enabled
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ===== Next.js Public Variables =====
# These are exposed to the browser, so use a different DSN if needed
NEXT_PUBLIC_SENTRY_DSN=https://your-public-sentry-dsn@sentry.io/your-project-id
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_PROFILES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_RELEASE=

# ===== Recommended Settings by Environment =====
#
# Development:
#   SENTRY_ENABLED=false
#   SENTRY_TRACES_SAMPLE_RATE=1.0  # Capture all transactions for testing
#
# Staging:
#   SENTRY_ENABLED=true
#   SENTRY_TRACES_SAMPLE_RATE=0.5  # 50% sampling
#
# Production:
#   SENTRY_ENABLED=true
#   SENTRY_TRACES_SAMPLE_RATE=0.1  # 10% sampling to control quota
#   SENTRY_PROFILES_SAMPLE_RATE=0.1
