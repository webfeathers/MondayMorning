# Railway Environment Variables Example
# Copy these to your Railway service environment variables

# ===== Database =====
# Automatically provided by Railway Postgres plugin
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# ===== Next.js Web Service =====
NODE_ENV=production
NEXTAUTH_SECRET=<generate-random-32-character-string>
NEXTAUTH_URL=https://your-domain.railway.app
AI_SERVICE_URL=http://ai-service.railway.internal:8000

# ===== Worker Service =====
# Same DATABASE_URL and AI_SERVICE_URL as web

# ===== AI Service =====
ENVIRONMENT=production
LOG_LEVEL=info
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ===== Sentry (Optional - All Services) =====
SENTRY_DSN=https://...@sentry.io/...
SENTRY_ENVIRONMENT=production
SENTRY_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# ===== For Next.js client (Public) =====
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_ENABLED=true

# ===== Generate secrets with =====
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
